{_ Fetch from context _}
{set reportbody to BodyDetails(state.eddi_context_body_name, state.eddi_context_body_system)}
{if !reportbody: 
    {set reportbody to BodyDetails(state.eddi_context_body_name)}
}

{SetState("first_footfall", false)}

{_ Begin processing _}

{if !reportbody.name || reportbody.name = "":
    
    {_ If it's still not possible to get the body name...  _}
    Which body are you
    {OneOf("asking about","referring to")}?
    
|else:

    {reportbody.bodytype} {Spacialise(reportbody.shortname)} scanned.
    
    {if find(reportbody.planettype, "Ammonia world") >= 0:
        This body is an uncommon type of planet classified as an ammonia world. These planets are {OneOf("analogous", "similar", "comparable")} to other terrestrial atmospheric planets, but are {OneOf("unique", "different")} in that they have ammonia-based life and {OneOf("large amounts", "significant reserves", "a significant amount")} of liquid ammonia at the surface trapped in lakes and oceans. Ammonia worlds like this one {OneOf("possess", "have", "feature")} an active weather system {OneOf("analogous", "similar", "comparable", "akin")} to Earth's, including {OneOf("destructive", "severe", "catastrophic", "damaging")} storms that produce liquid ammonia and methane rain.
    |elif find(reportbody.planettype, "Earth-like world") >= 0:
        This body is a rare type of planet classified as an earth-like world. These planets are {OneOf("analogous", "extremely similar", "comparable")} to Earth in the sol system, with diverse carbon-based life and abundant liquid water at the surface.
    |elif find(reportbody.planettype, "Water world") >= 0:
        This body is a rare type of planet classified as a water world. These planets have abundant liquid water at the surface, but no landmasses or solid ground above the water line. Water worlds like this one {OneOf("possess", "have", "feature")} an active weather system {OneOf("analogous", "similar", "comparable", "akin")} to Earth's, including {OneOf("massive", "colossal", "gigantic", "huge", "immense", "vast")} {OneOf("destructive", "severe", "catastrophic", "damaging")} {OneOf("cyclones", "monsoons", "hurricanes", "typhoons", "tempests")} that {OneOf("traverse", "travel across")} the planet's oceans.
    |elif find(reportbody.planettype, "ammonia based life") >= 0:
        This is {OneOf("fascinating", "intriguing")} commander. {OneOf("I am", "Sensors are", "Long range scans are")} {OneOf("detecting", "seeing", "picking up")} signs of life {OneOf("within", "inside of")} an ammonia cloud layer deep in the atmosphere of this planet. This layer also contains {OneOf("an excess of", "substantial amounts of", "")} oxygen and carbon-based compounds - likely a biproduct of what appear to be radioplankton {OneOf("floating", "hovering", "swimming")} {OneOf("within", "inside")} it. These organisms appear to {OneOf("behave", "act", "function", "operate")} {OneOf("analogously", "similarly", "comparably")} to algae on Earth, and are feeding off the {OneOf("intense", "energetic", "excessive", "powerful")} radiation hitting this planet.
    |elif find(reportbody.planettype, "water based life") >= 0:
        This is {OneOf("fascinating", "intriguing")} commander. {OneOf("I am", "Sensors are", "Long range scans are")} {OneOf("detecting", "seeing", "picking up")} signs of life {OneOf("within", "inside of")} a cloud layer deep in the atmosphere of this planet. This layer also contains {OneOf("an excess of", "substantial amounts of", "")} oxygen and carbon-based compounds - likely a biproduct of what appear to be radioplankton {OneOf("floating", "hovering", "swimming")} {OneOf("within", "inside")} it. These organisms appear to {OneOf("behave", "act", "function", "operate")} {OneOf("analogously", "similarly", "comparably")} to algae on Earth, and are feeding off the {OneOf("intense", "energetic", "excessive", "powerful")} radiation hitting this planet.
    |elif find(reportbody.planettype, "helium-rich") >= 0:
        This planet has a greatly inflated percentage of helium compared to the hydrogen in its atmosphere. Helium giants like this one form in hotter {OneOf("areas", "regions")} of star systems, which {OneOf("contributes to", "exacerbates", "accelerates")} the {OneOf("loss", "evaporation", "burnoff")} of hydrogen. These planets are extremely rare, making this one a truly exceptional find.
    |elif find(reportbody.planettype, "helium") >= 0:
        This planet has lost most of the hydrogen in its atmosphere due to its {OneOf("unusually low", "below average")} mass compared to other gas giants. Helium giants like this one form in hotter {OneOf("areas", "regions")} of star systems, which {OneOf("contributes to", "exacerbates", "accelerates")} the {OneOf("loss", "evaporation", "burnoff")} of hydrogen. These planets are extremely rare, making this one a truly exceptional find.
    |elif find(reportbody.planettype, "water giant") >= 0:
        This body is an uncommon type of planet classified as a water giant, and likely formed when a {OneOf("massive", "colossal", "gigantic", "huge", "immense", "vast", "large")} icy body warmed up enough for its surface ice to evaporate into water vapor. This would have {OneOf("triggered", "caused", "produced", "prompted", "provoked", "started", "resulted in")} a runaway greenhouse effect leading to a very thick atmosphere made up of ice crystals and water vapor.
    |elif find(reportbody.planettype, "giant") < 0:
        It is {if StartsWithVowel(reportbody.planettype): an |else: a } {reportbody.planettype}.
    }
    
    {_ Function to round numbers dynamically _}
    {set abs(val) to:
        {if val < 0:
            {return val * -1}
        |else:
            {return val}
        }
    }
    {set smartRound(val) to:
        {set absVal to abs(val)}
        {if absVal < 0.01:
            {return round(val, 3)}
        |elif absVal < 0.1:
            {return round(val, 2)}
        |elif absVal < 10:
            {return round(val, 1)}
        |else:
            {return round(val, 0)}
        }
    }
    
    {_ Convert atm to Earth units _}
    {set formatPressure(rawAtm) to:
        {set mathAtm to smartRound(rawAtm)}
        {set atmWord to "atmospheres"}
        {if mathAtm = 1:
            {set atmWord to "atmosphere"}
        }
        {set compStr to ""}
    
        {if mathAtm >= 1000:
            {set compStr to cat(Humanise(mathAtm), " times Earth's")}
        |elif mathAtm > 1:
            {set compStr to cat(mathAtm, " times Earth's")}
        |elif mathAtm = 1:
            {set compStr to "exactly equal to Earth's"}
        |elif mathAtm >= 0.75:
            {set compStr to "about three-quarters of Earth's"}
        |elif mathAtm >= 0.5:
            {set compStr to "about half of Earth's"}
        |elif mathAtm >= 0.25:
            {set compStr to "about a quarter of Earth's"}
        |elif mathAtm >= 0.1:
            {set compStr to "about a tenth of Earth's"}
        |else:
            {set compStr to "a tiny fraction of Earth's"}
        }
        {if mathAtm <= 0:
            {return "negligible atmospheric pressure, representing a tiny fraction of Earth's"}
        |else:
            {return cat(mathAtm, " ", atmWord, ", or ", compStr)}
        }
    }
    
    {_ Dynamically scale time into readable units _}
    {set formatTime(rawValue, baseUnit) to:
        {set mathVal to rawValue}
        
        {_ Catch retrograde spins and flip them to positive for the math _}
        {if mathVal < 0:
            {set mathVal to (mathVal * -1)}
        }
        
        {set timeStr to ""}
        
        {if baseUnit = "years":
            {if mathVal >= 1000:
                {set timeStr to cat(Humanise(smartRound(mathVal)), " Earth years")}
            |elif mathVal >= 1:
                {set timeStr to cat(smartRound(mathVal), " Earth years")}
            |else:
                {_ Convert fractions of a year into days _}
                {set timeStr to cat(smartRound(mathVal * 365), " Earth days")}
            }
        |elif baseUnit = "days":
            {if mathVal >= 1:
                {set timeStr to cat(smartRound(mathVal), " Earth days")}
            |elif (mathVal * 24) >= 1:
                {_ Convert fractions of a day into hours _}
                {set timeStr to cat(smartRound(mathVal * 24), " hours")}
            |else:
                {_ Convert tiny fractions into minutes _}
                {set timeStr to cat(smartRound(mathVal * 1440), " minutes")}
            }
        }
        {return timeStr}
    }
    
    {_ Custom Function to Calculate Z-Scores _}
    {set findAnomaly(scannedValue, mean, stdDev, statName, highAdj, lowAdj, valString) to:
        {set zScore to (scannedValue - mean) / stdDev}
        
        {if zScore > 3.0:
            {return [
                "percentile": cat("99 point ninth Percentile for ", statName), 
                "desc": cat("an extraordinarily ", highAdj, " ", statName, " of ", valString),
                "summary": cat("an extraordinarily ", highAdj, " ", statName)
            ]}
        |elif zScore > 2.0:
            {return [
                "percentile": cat("98th Percentile for ", statName), 
                "desc": cat("a very ", highAdj, " ", statName, " of ", valString),
                "summary": cat("a very ", highAdj, " ", statName)
            ]}
        |elif zScore > 1.0:
            {return [
                "percentile": cat("84th Percentile for ", statName), 
                "desc": cat("an unusually ", highAdj, " ", statName, " of ", valString),
                "summary": cat("an unusually ", highAdj, " ", statName)
            ]}
        |elif zScore < -3.0 && lowAdj != "":
            {return [
                "percentile": cat("bottom one tenth of one percent for ", statName), 
                "desc": cat("an extraordinarily ", lowAdj, " ", statName, " of ", valString),
                "summary": cat("an extraordinarily ", lowAdj, " ", statName)
            ]}
        |elif zScore < -2.0 && lowAdj != "":
            {return [
                "percentile": cat("2nd Percentile for ", statName), 
                "desc": cat("a very ", lowAdj, " ", statName, " of ", valString),
                "summary": cat("a very ", lowAdj, " ", statName)
            ]}
        |elif zScore < -1.0 && lowAdj != "":
            {return [
                "percentile": cat("16th Percentile for ", statName), 
                "desc": cat("an unusually ", lowAdj, " ", statName, " of ", valString),
                "summary": cat("an unusually ", lowAdj, " ", statName)
            ]}
        }
        
        {_ Return a completely empty array if the body is average _}
        {return []}
    }

    {_ Initialize the custom data dictionaries _}
    {set planetAnomalies to []}
    {set planetDescriptions to []}
    {set planetSummaries to []}
    
    {_ Define individual planet profiles _}
    {set ammoniaWorld to ["meanMass": 6.2799, "stdMass": 19.8256, "meanGrav": 1.2952, "stdGrav": 1.8376, "meanTilt": -0.0044, "stdTilt": 0.895, "meanEcc": 0.0382, "stdEcc": 0.0821, "meanInc": -0.0299, "stdInc": 17.0794, "meanOrbPer": 1967.3645, "stdOrbPer": 4799.2827, "meanRad": 8408.8509, "stdRad": 9898.005, "meanRotPer": 25.5202, "stdRotPer": 64.212, "meanPress": 1580.6746, "stdPress": 14923.1568, "meanTemp": 205.9566, "stdTemp": 209.6219]}
    
    {set ammoniaWorldMoon to ["meanMass": 0.4171, "stdMass": 0.9305, "meanGrav": 0.5155, "stdGrav": 0.5353, "meanTilt": -0.0098, "stdTilt": 0.5041, "meanEcc": 0.0018, "stdEcc": 0.0115, "meanInc": 0.2064, "stdInc": 46.6234, "meanOrbPer": 176.6825, "stdOrbPer": 249.9666, "meanRad": 5055.8395, "stdRad": 5425.5883, "meanRotPer": 44.1738, "stdRotPer": 70.5579, "meanPress": 32.184, "stdPress": 187.8536, "meanTemp": 210.0205, "stdTemp": 212.5352]}
    
    {set class1GasGiantMoon to ["meanMass": 58.2848, "stdMass": 111.7867, "meanGrav": 0.7864, "stdGrav": 1.0013, "meanTilt": -0.0037, "stdTilt": 0.6637, "meanEcc": 0.0079, "stdEcc": 0.0238, "meanInc": -0.2176, "stdInc": 36.8533, "meanOrbPer": 225.0037, "stdOrbPer": 320.9527, "meanRad": 38442.7324, "stdRad": 43678.7622, "meanRotPer": 78.8256, "stdRotPer": 137.8978, "meanTemp": 78.8198, "stdTemp": 87.2723]}
    
    {set class1GasGiant to ["meanMass": 115.8705, "stdMass": 179.9272, "meanGrav": 1.3946, "stdGrav": 1.6487, "meanTilt": -0.004, "stdTilt": 0.9595, "meanEcc": 0.0577, "stdEcc": 0.1346, "meanInc": -0.0809, "stdInc": 32.4585, "meanOrbPer": 8528.4827, "stdOrbPer": 175116.5171, "meanRad": 48188.4493, "stdRad": 51531.9972, "meanRotPer": 27.7785, "stdRotPer": 1754.2052, "meanTemp": 85.4838, "stdTemp": 91.8753]}
    
