    {set highMetalContentWorldMoon to ["meanMass": 0.1408, "stdMass": 0.4348, "meanGrav": 0.376, "stdGrav": 0.4611, "meanTilt": -0.005, "stdTilt": 0.8864, "meanEcc": 0.0124, "stdEcc": 0.0359, "meanInc": 0.0025, "stdInc": 2.7461, "meanOrbPer": 5.0572, "stdOrbPer": 8.7837, "meanRad": 2425.82, "stdRad": 2817.9575, "meanRotPer": 5.1381, "stdRotPer": 8.6649, "meanPress": 795.8505, "stdPress": 85228.672, "meanTemp": 297.9797, "stdTemp": 406.2542]}
    
    {set icyBody to ["meanMass": 1.7551, "stdMass": 6.1605, "meanGrav": 0.6271, "stdGrav": 0.8448, "meanTilt": -0.0044, "stdTilt": 0.916, "meanEcc": 0.0237, "stdEcc": 0.0582, "meanInc": -0.031, "stdInc": 17.5778, "meanOrbPer": 1332.3433, "stdOrbPer": 32409.3893, "meanRad": 4334.9637, "stdRad": 5128.2822, "meanRotPer": 20.6322, "stdRotPer": 61.1736, "meanPress": 14831.3194, "stdPress": 211027.6474, "meanTemp": 104.8767, "stdTemp": 195.9486]}
    
    {set icyBodyMoon to ["meanMass": 0.0181, "stdMass": 0.1776, "meanGrav": 0.0854, "stdGrav": 0.1112, "meanTilt": -0.0046, "stdTilt": 0.8075, "meanEcc": 0.0118, "stdEcc": 0.0369, "meanInc": -0.0569, "stdInc": 22.701, "meanOrbPer": 77.4856, "stdOrbPer": 276.4441, "meanRad": 1399.5289, "stdRad": 1746.7363, "meanRotPer": 21.8933, "stdRotPer": 43.6979, "meanPress": 47.8463, "stdPress": 4796.7091, "meanTemp": 84.202, "stdTemp": 105.1213]}
    
    {set metalRichBody to ["meanMass": 0.5361, "stdMass": 1.4286, "meanGrav": 1.0148, "stdGrav": 1.2492, "meanTilt": -0.0045, "stdTilt": 0.7431, "meanEcc": 0.0168, "stdEcc": 0.0567, "meanInc": -0.0213, "stdInc": 16.4608, "meanOrbPer": 39.795, "stdOrbPer": 32335.8862, "meanRad": 3024.364, "stdRad": 3539.1499, "meanRotPer": 7.1426, "stdRotPer": 19.6428, "meanPress": 138059.0238, "stdPress": 18039041.3784, "meanTemp": 1494.4781, "stdTemp": 1800.576]}
    
    {set metalRichBodyMoon to ["meanMass": 0.0036, "stdMass": 0.0322, "meanGrav": 0.1382, "stdGrav": 0.1762, "meanTilt": -0.0049, "stdTilt": 0.6041, "meanEcc": 0.0049, "stdEcc": 0.0225, "meanInc": -0.109, "stdInc": 38.8956, "meanOrbPer": 8.8889, "stdOrbPer": 29.7075, "meanRad": 511.1272, "stdRad": 634.9353, "meanRotPer": 5.3985, "stdRotPer": 13.4091, "meanPress": 23.2187, "stdPress": 9696.0802, "meanTemp": 1125.9144, "stdTemp": 1133.5205]}
    
    {set rockyIceWorld to ["meanMass": 0.6842, "stdMass": 1.4364, "meanGrav": 0.5775, "stdGrav": 0.6741, "meanTilt": -0.0043, "stdTilt": 0.9358, "meanEcc": 0.0213, "stdEcc": 0.0521, "meanInc": -0.0131, "stdInc": 9.3559, "meanOrbPer": 1244.6686, "stdOrbPer": 19155.6827, "meanRad": 5047.3398, "stdRad": 5622.709, "meanRotPer": 24.9787, "stdRotPer": 62.4842, "meanPress": 12565.3419, "stdPress": 181428.3321, "meanTemp": 208.8046, "stdTemp": 327.7442]}
    
    {set rockyIceWorldMoon to ["meanMass": 0.0146, "stdMass": 0.0402, "meanGrav": 0.136, "stdGrav": 0.1569, "meanTilt": -0.0049, "stdTilt": 0.6473, "meanEcc": 0.0075, "stdEcc": 0.0295, "meanInc": -0.1493, "stdInc": 37.1121, "meanOrbPer": 40.7858, "stdOrbPer": 92.6314, "meanRad": 1454.5252, "stdRad": 1640.1814, "meanRotPer": 19.6361, "stdRotPer": 31.6009, "meanPress": 84.849, "stdPress": 1682.1475, "meanTemp": 156.7053, "stdTemp": 217.3055]}
    
    {set rockyBody to ["meanMass": 0.6842, "stdMass": 1.4364, "meanGrav": 0.5775, "stdGrav": 0.6741, "meanTilt": -0.0012, "stdTilt": 0.6725, "meanEcc": 0.0299, "stdEcc": 0.073, "meanInc": -0.0131, "stdInc": 9.3559, "meanOrbPer": 1244.6686, "stdOrbPer": 19155.6827, "meanRad": 5047.3398, "stdRad": 5622.709, "meanRotPer": 24.9787, "stdRotPer": 62.4842, "meanPress": 12565.3419, "stdPress": 181428.3321, "meanTemp": 208.8046, "stdTemp": 327.7442]}
    
    {set rockyBodyMoon to ["meanMass": 0.0121, "stdMass": 0.0636, "meanGrav": 0.1361, "stdGrav": 0.1651, "meanTilt": -0.0045, "stdTilt": 0.7855, "meanEcc": 0.0119, "stdEcc": 0.0366, "meanInc": -0.053, "stdInc": 22.9972, "meanOrbPer": 22.3625, "stdOrbPer": 64.2106, "meanRad": 1121.9343, "stdRad": 1318.8036, "meanRotPer": 11.7241, "stdRotPer": 34.2495, "meanPress": 2.0704, "stdPress": 841.9282, "meanTemp": 156.7053, "stdTemp": 217.3055]}
        
    {set waterGiant to ["meanMass": 65.6381, "stdMass": 88.9537, "meanGrav": 5.2977, "stdGrav": 6.3643, "meanTilt": -0.002, "stdTilt": 1.2065, "meanEcc": 0.0422, "stdEcc": 0.0702, "meanInc": -0.0122, "stdInc": 17.52, "meanOrbPer": 6682.7014, "stdOrbPer": 8473.0567, "meanRad": 21304.0201, "stdRad": 21430.9222, "meanRotPer": 2.141, "stdRotPer": 25.6108, "meanTemp": 177.3021, "stdTemp": 183.4611]}
    
    {set waterGiantMoon to ["meanMass": 32.3335, "stdMass": 33.847, "meanGrav": 3.0105, "stdGrav": 3.0581, "meanTilt": -0.0178, "stdTilt": 0.3242, "meanEcc": 0, "stdEcc": 0, "meanInc": -3.689, "stdInc": 49.8002, "meanOrbPer": 1012.402, "stdOrbPer": 1058.2208, "meanRad": 20671.7083, "stdRad": 20704.9192, "meanRotPer": 1.3031, "stdRotPer": 1.6669, "meanTemp": 163.0412, "stdTemp": 163.2902]}
    
    {set waterWorld to ["meanMass": 1.5501, "stdMass": 4.2285, "meanGrav": 1.0469, "stdGrav": 1.2012, "meanTilt": -0.0047, "stdTilt": 0.9393, "meanEcc": 0.029, "stdEcc": 0.0781, "meanInc": -0.0337, "stdInc": 17.3069, "meanOrbPer": 1061.164, "stdOrbPer": 3662.2637, "meanRad": 6127.881, "stdRad": 6583.8553, "meanRotPer": 28.5078, "stdRotPer": 90.9659, "meanPress": 6482865.1028, "stdPress": 44764861.862, "meanTemp": 318.3108, "stdTemp": 328.1222]}
    
    {set waterWorldMoon to ["meanMass": 0.3514, "stdMass": 0.5495, "meanGrav": 0.5327, "stdGrav": 0.5633, "meanTilt": -0.0074, "stdTilt": 0.4866, "meanEcc": 0.0119, "stdEcc": 0.0366, "meanInc": -0.6084, "stdInc": 47.3019, "meanOrbPer": 95.5885, "stdOrbPer": 165.1347, "meanRad": 4869.4239, "stdRad": 5053.1573, "meanRotPer": 44.1077, "stdRotPer": 63.0166, "meanPress": 29.079, "stdPress": 114.1393, "meanTemp": 283.3591, "stdTemp": 288.7738]}
    
    {set isMoon to false}
    
    {_ First check: EDDI's built-in bodytype _}
    {if reportbody.bodytype = "Moon":
        {set isMoon to true}
    }
    
    {_ Second check: The parents array _}
    {if reportbody.parents && len(reportbody.parents) > 0:
        {for parent in reportbody.parents:
            {if has(parent, "Planet"):
                {set isMoon to true}
            }
        }
    }
    
    {_ Build the dynamic lookup key _}
    {set lookupKey to reportbody.planettype}
    
    {if isMoon = true:
        {set lookupKey to cat(reportbody.planettype, " Moon")}
    }
    
    {_ Package all individual profiles into the Master Dictionary _}
    {set astroData to [
        "Ammonia world": ammoniaWorld,
        "Ammonia world Moon": ammoniaWorldMoon,
        "Class I gas giant": class1GasGiant,
        "Class I gas giant Moon": class1GasGiantMoon,
        "Class II gas giant": class2GasGiant,
        "Class II gas giant Moon": class2GasGiantMoon,
        "Class III gas giant": class3GasGiant,
        "Class III gas giant Moon": class3GasGiantMoon,
        "Class IV gas giant": class4GasGiant,
        "Class IV gas giant Moon": class4GasGiantMoon,
        "Class V gas giant": class5GasGiant,
        "Class V gas giant Moon": class5GasGiantMoon,
        "Gas giant with ammonia based life": ammoniaLifeGasGiant,
        "Gas giant with ammonia based life Moon": ammoniaLifeGasGiantMoon,
        "Gas giant with water based life": waterLifeGasGiant,
        "Gas giant with water based life Moon": waterLifeGasGiantMoon,
        "Helium gas giant": heliumGasGiant,
        "Helium gas giant Moon": heliumGasGiantMoon,
        "Helium-rich gas giant": heliumRichGasGiant,
        "Helium-rich gas giant Moon": heliumRichGasGiantMoon,
        "Earth-like world": earthLikeWorld,
        "Earth-like world Moon": earthLikeWorldMoon,
        "High metal content world": highMetalContentWorld,
        "High metal content world Moon": highMetalContentWorldMoon,
        "Icy body": icyBody,
        "Icy body Moon": icyBodyMoon,
        "Metal-rich body": metalRichBody,
        "Metal-rich body Moon": metalRichBodyMoon,
        "Rocky Ice world": rockyIceWorld,
        "Rocky Ice world Moon": rockyIceWorldMoon,
        "Rocky body": rockyBody,
        "Rocky body Moon": rockyBodyMoon,
        "Water giant": waterGiant,
        "Water giant Moon": waterGiantMoon,
        "Water world": waterWorld,
        "Water world Moon": waterWorldMoon
    ]}
    
    {_ Calculate Z-Scores _}
    {if has(astroData, lookupKey):
        {_ Save the current dictionary to a shorter variable to save typing _}
        {set current to astroData[lookupKey]}
        {if reportbody.earthmass >= 1000:
            {set massString to cat(Humanise(smartRound(reportbody.earthmass)), " Earth masses")}
        |else:
            {set massString to cat(smartRound(reportbody.earthmass), " Earth masses")}
        }
        {set anomaly to findAnomaly(reportbody.earthmass, current["meanMass"], current["stdMass"], "mass", "high", "low", massString)}
        {if len(anomaly) > 0: 
            {set planetAnomalies to cat(planetAnomalies, [anomaly["percentile"]])}
            {set planetDescriptions to cat(planetDescriptions, [anomaly["desc"]])}
            {set planetSummaries to cat(planetSummaries, [anomaly["summary"]])}
        }
        
        {set gravString to cat(smartRound(reportbody.gravity), " g")}
        {set anomaly to findAnomaly(reportbody.gravity, current["meanGrav"], current["stdGrav"], "gravity", "high", "low", gravString)}
        {if len(anomaly) > 0: 
            {set planetAnomalies to cat(planetAnomalies, [anomaly["percentile"]])}
            {set planetDescriptions to cat(planetDescriptions, [anomaly["desc"]])}
            {set planetSummaries to cat(planetSummaries, [anomaly["summary"]])}
        }
        
        {if state.report_notable_orbit != 0:
            {set tiltString to cat(smartRound(abs(reportbody.tilt*(180/3.14))), " degrees")}
            {set anomaly to findAnomaly(abs(reportbody.tilt), abs(current["meanTilt"]), current["stdTilt"], "axial tilt", "steep", "shallow", tiltString)}
            {if len(anomaly) > 0: 
                {set planetAnomalies to cat(planetAnomalies, [anomaly["percentile"]])}
                {set planetDescriptions to cat(planetDescriptions, [anomaly["desc"]])}
                {set planetSummaries to cat(planetSummaries, [anomaly["summary"]])}
            }
        }
        
        {if state.report_notable_orbit != 0:
            {set eccString to smartRound(reportbody.eccentricity)}
            {set anomaly to findAnomaly(reportbody.eccentricity, current["meanEcc"], current["stdEcc"], "eccentricity", "high", "", eccString)}
            {if len(anomaly) > 0: 
                {set planetAnomalies to cat(planetAnomalies, [anomaly["percentile"]])}
                {set planetDescriptions to cat(planetDescriptions, [anomaly["desc"]])}
                {set planetSummaries to cat(planetSummaries, [anomaly["summary"]])}
            }
        }
        
        {if state.report_notable_orbit != 0:
            {set incString to cat(smartRound(abs(reportbody.inclination)), " degrees")}
            {set anomaly to findAnomaly(abs(reportbody.inclination), abs(current["meanInc"]), current["stdInc"], "orbit inclination", "steep", "shallow", incString)}
            {if len(anomaly) > 0: 
                {set planetAnomalies to cat(planetAnomalies, [anomaly["percentile"]])}
                {set planetDescriptions to cat(planetDescriptions, [anomaly["desc"]])}
                {set planetSummaries to cat(planetSummaries, [anomaly["summary"]])}
            }
        }
        
        {set orbPerString to formatTime(reportbody.orbitalperiod, "years")}
        {set anomaly to findAnomaly(reportbody.orbitalperiod, current["meanOrbPer"], current["stdOrbPer"], "orbital period length", "long", "short", orbPerString)}
        {if len(anomaly) > 0: 
            {set planetAnomalies to cat(planetAnomalies, [anomaly["percentile"]])}
            {set planetDescriptions to cat(planetDescriptions, [anomaly["desc"]])}
            {set planetSummaries to cat(planetSummaries, [anomaly["summary"]])}
        }
        
        {if reportbody.radius >= 1000:
            {set radString to cat(Humanise(smartRound(reportbody.radius)), " kilometers")}
        |else:
            {set radString to cat(smartRound(reportbody.radius), " kilometers")}
        }
        {set anomaly to findAnomaly(reportbody.radius, current["meanRad"], current["stdRad"], "radius", "large", "small", radString)}
        {if len(anomaly) > 0: 
            {set planetAnomalies to cat(planetAnomalies, [anomaly["percentile"]])}
            {set planetDescriptions to cat(planetDescriptions, [anomaly["desc"]])}
            {set planetSummaries to cat(planetSummaries, [anomaly["summary"]])}
        }
        
        {if reportbody.tidallylocked = false:
            {set rotPerString to formatTime(reportbody.rotationalperiod, "days")}
            {set anomaly to findAnomaly(reportbody.rotationalperiod, current["meanRotPer"], current["stdRotPer"], "rotational period length", "long", "short", rotPerString)}
            {if len(anomaly) > 0: 
                {set planetAnomalies to cat(planetAnomalies, [anomaly["percentile"]])}
                {set planetDescriptions to cat(planetDescriptions, [anomaly["desc"]])}
                {set planetSummaries to cat(planetSummaries, [anomaly["summary"]])}
            }
        }
        
        {if has(reportbody, "pressure") && reportbody.pressure > 0 && find(reportbody.planettype, "giant") < 0:
            {set pressString to formatPressure(reportbody.pressure)}
            {set anomaly to findAnomaly(reportbody.pressure, current["meanPress"], current["stdPress"], "surface pressure", "high", "low", pressString)}
            {if len(anomaly) > 0: 
                {set planetAnomalies to cat(planetAnomalies, [anomaly["percentile"]])}
                {set planetDescriptions to cat(planetDescriptions, [anomaly["desc"]])}
                {set planetSummaries to cat(planetSummaries, [anomaly["summary"]])}
            }
        }
        
        {if reportbody.temperature >= 1000:
            {set tempString to cat(Humanise(smartRound(reportbody.temperature)), " degrees kelvin")}
        |else:
            {set tempString to cat(smartRound(reportbody.temperature), " degrees kelvin")}
        }
        {set anomaly to findAnomaly(reportbody.temperature, current["meanTemp"], current["stdTemp"], "surface temperature", "high", "low", tempString)}
        {if len(anomaly) > 0: 
            {set planetAnomalies to cat(planetAnomalies, [anomaly["percentile"]])}
            {set planetDescriptions to cat(planetDescriptions, [anomaly["desc"]])}
            {set planetSummaries to cat(planetSummaries, [anomaly["summary"]])}
        }
    }
    
    {if len(planetSummaries) > 0:
        {set shortSummary to cat(reportbody.bodytype, " ", Spacialise(reportbody.shortname), " has ", List(planetSummaries), ". ")}
        
        {set currentSummary to state.notable_system_summary}
        {if !currentSummary:
            {set currentSummary to ""}
        }
        {SetState("notable_system_summary", cat(currentSummary, shortSummary))}
    }
    
    {_ Speech Output _}
    {if len(planetAnomalies) > 0:
    
        {if find(reportbody.planettype, "Class I gas") >= 0:
            This class one gas giant is in the {List(planetAnomalies)} compared to other planets of its type.
        |else:
            This {reportbody.planettype} is in the {List(planetAnomalies)} compared to other
            
            {if isMoon = true:
                moons
            |else:
                planets
            }
            
            of its type.
        }
        
        {_ Check global variable before speaking the descriptions _}
        {if state.extended_percentile != 0:
            It has {List(planetDescriptions)}.
        }
    }
    
    {F("[EXTRA SCIENCE] Body Volcanism Report")}
    {F("[EXTRA SCIENCE] Body Materials Report")}
    
}