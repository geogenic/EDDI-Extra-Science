{_ Context _}
{SetState('eddi_context_last_subject', 'body')}
{SetState('eddi_context_last_action', 'scan')}
{SetState('eddi_context_body_system', system.name)}
{SetState('eddi_context_body_name', event.name)}
{SetState('eddi_context_last_scan_estimated_value', event.estimatedvalue)}

{_ Fetch from context _}
{set reportbody to BodyDetails(state.eddi_context_body_name, state.eddi_context_body_system)}
{if !reportbody: 
    {set reportbody to BodyDetails(state.eddi_context_body_name)}
}

{_ Process the event _}
{Pause(3000)}

{OneOf("Mapping", "Surface map", "Surface scan")}
of {reportbody.bodytype} {Spacialise(reportbody.shortname)} 
{OneOf("is", "is now", " ")}
{OneOf("complete", "finished")}.

{if event.probesused <= event.efficiencytarget:
    Efficiency bonus {OneOf("awarded", "granted")}.
}

{if find(reportbody.reserves, "Pristine") >= 0:
    This pristine
|elif find(reportbody.reserves, "Major") >= 0:
    This rich
}

{set ringname to []}
{set ringcomposition to []}
{for Ring in reportbody.rings:
    {if find(ringcomposition, Ring.composition) < 0:
        {set ringcomposition to cat(ringcomposition, [Ring.composition])}
    }
}

{if len(ringcomposition) > 0:
    {List(ringcomposition)}
}

{if find(ringname[0], "Belt") >= 0: 
    {set ring to "belt"}
|else:
    {set ring to "ring"}
}.

{if reportbody.landable = true && (reportbody.temperature > 700 || reportbody.gravity > 1):

    {_ Hazard flags _}
    {set lethalTemp to reportbody.temperature > 700}
    {set lethalGrav to reportbody.gravity > 2.69}
    {set hardLanding to reportbody.gravity > 1}

    {_ On-foot hazards _}
    {if lethalTemp || lethalGrav:
        Take {OneOf("caution", "care")} when {OneOf("disembarking", "leaving your ship")}. This {reportbody.planettype} has 
        {if lethalTemp && lethalGrav:
            surface temperatures and gravity that exceed
        |elif lethalTemp:
            surface temperatures that exceed
        |else:
            surface gravity that exceeds
        }
        the limits of your {OneOf("exploration suit", "artemis suit", "suit", "exosuit", "protective gear")} , and will be {OneOf("acutely", "severely", "critically", "seriously")} hazardous to your health.
    }

    {_ Flight hazards _}
    {if hardLanding:
        This planet's {OneOf("high", "elevated", "strong")} surface gravity will
        {if lethalTemp || lethalGrav:
            also
        }
        make landing here {OneOf("a challenge", "difficult", "quite arduous")} . Be sure to descend {OneOf("slowly", "gently", "at a leisurely pace")} once you are out of glide.
    }
}

{Pause(2000)}
           
{SetState("first_footfall", false)}