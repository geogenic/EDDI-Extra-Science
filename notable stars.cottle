{_ Fetch from context _}
{set reportbody to BodyDetails(state.eddi_context_star_star, state.eddi_context_star_system)}
{if !reportbody: {set reportbody to BodyDetails(state.eddi_context_star_star)}}
{if !reportbody && event: {set reportbody to event.star}}

{SetState("first_footfall", false)}

{_ Begin processing _}

{if !reportbody.name || reportbody.name = "":
    Which star are you {OneOf("asking about", "referencing")}?
|else:
    {_ Function to round numbers dynamically _}
    {set abs(val) to:
        {if val < 0:
            {return val * -1}
        |else:
            {return val}
        }
    }
    
    {set smartRound(val) to:
        {set absVal to abs(val)}
        {if absVal < 0.01:
            {return round(val, 3)}
        |elif absVal < 0.1:
            {return round(val, 2)}
        |elif absVal < 10:
            {return round(val, 1)}
        |else:
            {return round(val, 0)}
        }
    }
    
    {_ Dynamically scale time into readable units _}
    {set formatTime(rawValue, baseUnit) to:
        {set mathVal to rawValue}
        
        {_ Catch retrograde spins and flip them to positive for the math _}
        {if mathVal < 0:
            {set mathVal to (mathVal * -1)}
        }
        
        {set timeStr to ""}
        
        {if baseUnit = "years":
            {if mathVal >= 1:
                {if mathVal >=1000:
                    {set timeStr to cat(Humanise(smartRound(mathVal)), " Earth years")}
                |else:
                    {set timeStr to cat(smartRound(mathVal), " Earth years")}
                }
            |else:
                {_ Convert fractions of a year into days _}
                {set timeStr to cat(smartRound(mathVal * 365), " Earth days")}
            }
        |elif baseUnit = "days":
            {if mathVal >= 1:
                {set timeStr to cat(smartRound(mathVal), " Earth days")}
            |elif (mathVal * 24) >= 1:
                {_ Convert fractions of a day into hours _}
                {set timeStr to cat(smartRound(mathVal * 24), " hours")}
            |else:
                {_ Convert tiny fractions into minutes _}
                {set timeStr to cat(smartRound(mathVal * 1440), " minutes")}
            }
        }
        {return timeStr}
    }

    {_ Custom Function to translate Luminosity Classes into phonetic speech _}
    {set speakLuminosity(rawClass) to:
        {set lumMap to [
            "0": "0", "Ia0": "1 A 0", "Ia": "1 A", "Iab": "1 A B", "Ib": "1 B", "I": "1",
            "IIa": "2 A", "IIab": "2 A B", "IIb": "2 B", "II": "2",
            "IIIa": "3 A", "IIIab": "3 A B", "IIIb": "3 B", "III": "3",
            "IVa": "4 A", "IVab": "4 A B", "IVb": "4 B", "IV": "4",
            "Va": "5 A", "Vab": "5 A B", "Vb": "5 B", "Vz": "5 Z", "V": "5",
            "VI": "6", "VII": "7"
        ]}
        
        {if has(lumMap, rawClass):
            {return lumMap[rawClass]}
        |else:
            {_ Failsafe just in case a strange string slips through _}
            Anomaly found. Fix the script to include this exception!
            {return rawClass}
        }
    }
    
    {_ Custom Function to Calculate Z-Scores _}
    {set findAnomaly(scannedValue, mean, stdDev, statName, highAdj, lowAdj, valString) to:
        {set zScore to (scannedValue - mean) / stdDev}
        
        {if zScore > 3.0:
            {return [
                cat("99 point ninth Percentile for ", statName), 
                cat("an extraordinarily ", highAdj, " ", statName, " of ", valString)
            ]}
        |elif zScore > 2.0:
            {return [
                cat("98th Percentile for ", statName), 
                cat("a very ", highAdj, " ", statName, " of ", valString)
            ]}
        |elif zScore > 1.0:
            {return [
                cat("84th Percentile for ", statName), 
                cat("an unusually ", highAdj, " ", statName, " of ", valString)
            ]}
        |elif zScore < -3.0 && lowAdj != "":
            {return [
                cat("bottom one tenth of one percent for ", statName), 
                cat("an extraordinarily ", lowAdj, " ", statName, " of ", valString)
            ]}
        |elif zScore < -2.0 && lowAdj != "":
            {return [
                cat("2nd Percentile for ", statName), 
                cat("a very ", lowAdj, " ", statName, " of ", valString)
            ]}
        |elif zScore < -1.0 && lowAdj != "":
            {return [
                cat("16th Percentile for ", statName), 
                cat("an unusually ", lowAdj, " ", statName, " of ", valString)
            ]}
        }
        
        {_ Return a completely empty array if the planet is average _}
        {return []}
    }
    
    {_ Define individual planet profiles _}
    {set ABlueWhiteSuperGiant to ["meanMag": -6.3632, "stdMag": 6.979, "meanAge": 276.6211, "stdAge": 383.5253, "meanTilt": 0, "stdTilt": 0.0027, "meanEcc": 0.1555, "stdEcc": 0.1961, "meanInc": 0.218, "stdInc": 45.3386, "meanOrbPer": 335090.7142, "stdOrbPer": 816482.876, "meanRotPer": 38.0569, "stdRotPer": 62.2784, "meanSolMass": 14.1404, "stdSolMass": 25.6286, "meanSolRad": 102.5079, "stdSolRad": 166.8194, "meanTemp": 9999.47, "stdTemp": 10993.9944]}
    
    {set A to ["meanMag": 2.6988, "stdMag": 2.7287, "meanAge": 1469.1929, "stdAge": 1693.2802, "meanTilt": 0, "stdTilt": 0.0078, "meanEcc": 0.1512, "stdEcc": 0.1931, "meanInc": -0.0102, "stdInc": 44.9895, "meanOrbPer": 663212.6978, "stdOrbPer": 1545529.7555, "meanRotPer": 1.1266, "stdRotPer": 1.5281, "meanSolMass": 1.6572, "stdSolMass": 1.7047, "meanSolRad": 1.3836, "stdSolRad": 2.66, "meanTemp": 8090.9088, "stdTemp": 8105.3394]}
    
    {set BBlueWhiteSuperGiant to ["meanMag": -11.4264, "stdMag": 11.9747, "meanAge": 46.1837, "stdAge": 150.5756, "meanTilt": 0, "stdTilt": 0.0032, "meanEcc": 0.1552, "stdEcc": 0.1962, "meanInc": -0.7719, "stdInc": 44.7999, "meanOrbPer": 140346.599, "stdOrbPer": 386557.9602, "meanRotPer": 114.3334, "stdRotPer": 129.3345, "meanSolMass": 49.7008, "stdSolMass": 56.7736, "meanSolRad": 307.991, "stdSolRad": 346.0677, "meanTemp": 18350.2526, "stdTemp": 19681.4024]}
    
    {set B to ["meanMag": -1.2493, "stdMag": 2.3128, "meanAge": 171.2351, "stdAge": 248.2802, "meanTilt": 0, "stdTilt": 0.0214, "meanEcc": 0.1484, "stdEcc": 0.1908, "meanInc": -0.1223, "stdInc": 45.0393, "meanOrbPer": 349895.4936, "stdOrbPer": 897363.46, "meanRotPer": 1.7969, "stdRotPer": 10.6328, "meanSolMass": 5.2049, "stdSolMass": 7.4921, "meanSolRad": 4.8428, "stdSolRad": 28.4959, "meanTemp": 15118.9995, "stdTemp": 15782.0714]}
    
    {set H to ["meanAge": 7343.753, "stdAge": 8558.1264, "meanTilt": 0, "stdTilt": 0.0008, "meanEcc": 0.1486, "stdEcc": 0.191, "meanInc": 0.0066, "stdInc": 45.0029, "meanOrbPer": 340710.0713, "stdOrbPer": 885867.141, "meanSolMass": 9.1112, "stdSolMass": 13.7337, "meanSolRad": 0, "stdSolRad": 0.0001, "meanTemp": 6983.6, "stdTemp": 7401.8963]}
    
    {set C to ["meanMag": 0.3018, "stdMag": 0.5251, "meanAge": 10524.1626, "stdAge": 10828.9008, "meanTilt": 0.0001, "stdTilt": 0.0265, "meanEcc": 0.1535, "stdEcc": 0.1949, "meanInc": 0.0951, "stdInc": 44.818, "meanOrbPer": 851594.334, "stdOrbPer": 1969039.956, "meanRotPer": 116.1311, "stdRotPer": 119.0088, "meanSolMass": 1.0579, "stdSolMass": 1.0664, "meanSolRad": 30.721, "stdSolRad": 30.91, "meanTemp": 2969.9942, "stdTemp": 2979.362]}
    
